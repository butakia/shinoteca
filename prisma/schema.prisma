generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Newly uploaded songs only — the existing demo catalog in src/lib/data stays
// a static fixture. SongsContext merges this table's rows in alongside it, so
// nothing about the existing (working) catalog/edit-overlay system has to
// change to support real uploads.
//
// isPublished doubles as the moderation flag: uploads from regular users are
// created with isPublished=false ("pendiente de aprobación") and only show up
// in the public catalog once an admin approves them from /admin. Admin's own
// uploads are created already-published, skipping the queue.
model UploadedSong {
  id          String   @id @default(cuid())
  title       String
  artist      String
  alias       String?
  releaseType String   @default("single")
  year        Int?
  genre       String?
  duration    Int      @default(0)
  coverUrl    String?
  audioUrl    String
  lyrics      String?
  description String?
  tags        String   @default("[]") // JSON string array
  isPublished Boolean  @default(true)
  isThirdParty Boolean @default(false)
  createdAt   DateTime @default(now())
  uploaderId  String?
  uploader    User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
}

// Real accounts — replaces the old client-only demo-password gate on /admin.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  isAdmin      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  uploads      UploadedSong[]
}

// Server-side sessions: the cookie only carries the random token below, so a
// stolen/expired token can be invalidated server-side by deleting the row —
// something a self-contained signed JWT can't do without a revocation list.
model Session {
  token     String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Global "me gusta" counter per song, shared by every visitor (unlike the
// per-browser reaction stored in localStorage). songId matches whatever id
// the app already uses for that song — demo catalog ids and up-* uploaded
// ids alike — so no foreign key to UploadedSong.
model SongLike {
  songId String @id
  count  Int    @default(0)
}

// Admin edits to a STATIC catalog song (title/cover/genre/etc. — anything
// from the "Editar canción" modal) used to live only in the admin's own
// browser localStorage: it looked like it worked (visible immediately to
// whoever made the edit) but no other visitor, on any other device, ever
// saw it. patch is a JSON-encoded Partial<Song>, merged server-side into the
// catalog every visitor gets from getUploadedSongs()/the songs API.
model SongOverride {
  songId    String   @id
  patch     String
  updatedAt DateTime @updatedAt
}

// Same per-browser problem as above, but for "eliminar" on a static catalog
// song: soft-deleted it only in the deleting admin's own browser.
model DeletedSong {
  songId    String   @id
  deletedAt DateTime @default(now())
}

// Admin edits to a notice/disclaimer (text, enabled, visibility, priority —
// anything from the "Avisos" tab in /admin) used to live only in
// localStorage, same per-browser problem as SongOverride above. patch is a
// JSON-encoded Partial<Notice>, keyed by NoticeKey.
model NoticeOverride {
  key       String   @id
  patch     String
  updatedAt DateTime @updatedAt
}

// Cover/title overrides for an album, plus admin-created albums that don't
// exist in the static fixtures (e.g. "Inéditos"). isCustom distinguishes a
// brand-new album from a patch to an existing static one — patch is a
// JSON-encoded Partial<Album> either way.
model AlbumOverride {
  albumId   String   @id
  patch     String
  isCustom  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
